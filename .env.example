# 서버 포트
PORT=2567

# 클라이언트 → 서버 WebSocket 주소(클라이언트 빌드 시 사용)
# 로컬 개발: ws://localhost:2567
# 도커 내부: ws://server:2567
VITE_SERVER_URL=ws://localhost:2567
VITE_COMBAT_SERVER_URL=ws://localhost:2567

# 개발 환경
NODE_ENV=development

# 개발용 임의 피해 주입. 서버와 클라이언트 양쪽을 명시적으로 켜야 한다.
# 운영 환경에서는 서버 값이 true여도 비활성화된다.
ENABLE_DEBUG_COMBAT_COMMANDS=false
VITE_ENABLE_DEBUG_COMBAT_COMMANDS=false
VITE_ENABLE_DEBUG_HUD=false
VITE_ENABLE_SPIKE_ROOM=false
VITE_ENABLE_LOCAL_FALLBACK=false
VITE_ENABLE_CHARACTER_ASSET_TEST=false
VITE_CHARACTER_ASSET_TEST_FIGHTER=player-left

# 쉼표로 구분한 클라이언트 origin. production 서버에서는 필수다.
ALLOWED_ORIGINS=http://localhost:5173
ENABLE_SPIKE_ROOM=false
